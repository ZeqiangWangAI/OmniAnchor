{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OmniAnchor planned experiment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "accepted_experiments", "title", "status", "seed", "inputs", "metrics", "protocol", "budget"],
  "properties": {
    "schema_version": {"const": 1},
    "protocol_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "accepted_experiments": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6"]}},
    "title": {"type": "string"},
    "status": {"const": "planned"},
    "seed": {"type": "integer"},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["adapter", "kwargs", "role"],
        "properties": {
          "adapter": {"enum": ["valueeval", "emobank", "chinese_emobank", "oasis", "viva", "wic", "dwug", "vatex", "fmat"]},
          "kwargs": {"type": "object"},
          "role": {"type": "string"}
        }
      }
    },
    "metrics": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "protocol": {
      "type": "object", "required": ["unit", "development", "test", "claim_boundary"],
      "properties": {
        "unit": {"type": "string"}, "development": {"type": "string"},
        "test": {"type": "string"}, "claim_boundary": {"type": "string"}
      }
    },
    "budget": {
      "type": "object", "required": ["max_smoke_samples", "model_parameter_cap"],
      "properties": {
        "max_smoke_samples": {"type": "integer", "minimum": 1},
        "model_parameter_cap": {"type": "integer", "maximum": 4000000000, "minimum": 1}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
